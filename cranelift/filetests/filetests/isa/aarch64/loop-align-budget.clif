;   mov w3, #0
;   mov x0, x3
; block1: ; offset 0xc
;   mov w7, #0
; block2: ; offset 0x10
;   add w13, w7, #1
;   add w0, w0, w7
;   cmp w13, w1
;   b.hs #0x28
; block3: ; offset 0x20
;   mov x7, x13
;   b #0x10
; block4: ; offset 0x28
;   add w3, w3, #1
;   mov x2, x12
;   cmp w3, w2
;   b.hs #0x40
; block5: ; offset 0x38
;   mov x12, x2
