;   b label1
; block1:
;   movz w7, #0
;   b label2
; block2:
;   add w13, w7, #1
;   add w0, w0, w7
;   subs wzr, w13, w1
;   b.lo label3 ; b label4
; block3:
;   mov x7, x13
;   b label2
; block4:
;   add w3, w3, #1
;   mov x2, x12
;   subs wzr, w3, w2
;   b.lo label5 ; b label6
; block5:
;   mov x12, x2
;   b label1
; block6:
;   ret
