test compile precise-output
set opt_level=speed
set loop_align_log2=5
set loop_align_max_padding=4
target x86_64

;; A loop header that needs more padding than the budget stays unaligned.
function %nested(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 0
    jump block1(v2, v2)

block1(v3: i32, v4: i32):
    v5 = iconst.i32 0
    jump block2(v5, v4)

block2(v6: i32, v7: i32):
    v8 = iadd v7, v6
    v13 = iconst.i32 1
    v9 = iadd v6, v13
    v10 = icmp ult v9, v1
    brif v10, block2(v9, v8), block3

block3:
    v14 = iconst.i32 1
    v11 = iadd v3, v14
    v12 = icmp ult v11, v0
    brif v12, block1(v11, v8), block4

block4:
    return v8
}

